{
  "name": "maiv-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "format": "dotnet format MAIV-API.sln",
    "generate-jwt-secret": "openssl rand -base64 64 | tr -d '\n' && echo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6"
  },
  "lint-staged": {
    "*.cs": [
      "echo 'Running dotnet format on MAIV-API.sln…'",
      "dotnet format MAIV-API.sln --include"
    ]
  }
}
